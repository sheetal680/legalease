# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should NEVER be committed.

# ── Frontend (Vite exposes these to the browser bundle) ──────────────────────
# Find both values in: Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-side only (seed script — never exposed to the browser) ─────────────
# Find this in: Supabase → Project Settings → API → service_role (secret)
# Only needed when running: npm run seed
SUPABASE_SERVICE_ROLE_KEY=
